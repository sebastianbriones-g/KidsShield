# KidsShield Server Configuration

# Puerto del servidor (Por defecto 3000)
PORT=3000

# Base de datos Turso (LibSQL Cloud)
# Si se dejan en blanco, el servidor usará automáticamente SQLite local embebido (kidsshield.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Autenticación Google OAuth (Google Identity Services)
# Client ID obtenido de Google Cloud Console -> APIs y Servicios -> Credenciales
GOOGLE_CLIENT_ID=

# Clave Secreta Criptográfica para JWT (Sesiones de Usuarios)
JWT_SECRET=reemplazar_con_clave_secreta_aleatoria_de_64_caracteres

# Servicio de Envío de Correos SMTP (Recuperación de Contraseña)
# Si se dejan vacíos, el servidor creará automáticamente una cuenta de prueba en Ethereal Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KidsShield Soporte" <soporte@tudominio.com>
