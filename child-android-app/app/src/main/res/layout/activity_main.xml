<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ KidsShield"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configuración Inicial del Dispositivo del Hijo"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#1E293B" />

        <!-- Permissions Title & Assistant Header -->
        <LinearLayout
            android:id="@+id/cardPermissionsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1B4B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvPermissionsSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Asistente de Configuración de Permisos"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionsSummaryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Verificando permisos del sistema..."
                android:textColor="#A5B4FC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGrantNextMissingPermission"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#4F46E5"
                android:text="🚀 Otorgar Siguiente Permiso Faltante"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Step 1: Usage Access -->
        <LinearLayout
            android:id="@+id/cardPermUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Acceso a Datos de Uso"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Permite contabilizar los minutos de uso en redes sociales, juegos y apps."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantUsageAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Conceder Acceso a Uso"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Step 2: Accessibility Service -->
        <LinearLayout
            android:id="@+id/cardPermA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Servicio de Accesibilidad"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Permite detectar al instante aperturas de apps bloqueadas y proteger el GPS."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Activar Accesibilidad"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Step 3: Overlay Permission -->
        <LinearLayout
            android:id="@+id/cardPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Superposición de Pantalla"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Muestra la pantalla de bloqueo cuando se agota el tiempo permitido."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Habilitar Superposición"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Step 4: GPS Location Permission -->
        <LinearLayout
            android:id="@+id/cardPermGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Ubicación GPS Satelital Ininterrumpible"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rastrea la posición en vivo las 24 horas y previene que el menor apague el GPS."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Activar Ubicación GPS Continua"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Step 5: Device Admin -->
        <LinearLayout
            android:id="@+id/cardPermAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Administrador de Dispositivo (Anti-Desinstalación)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Evita que el menor desinstale la aplicación desde Ajustes de Android."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantDeviceAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Activar Administrador"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Step 6: Battery Optimization & Background Execution -->
        <LinearLayout
            android:id="@+id/cardPermBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#121826"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Sin Restricción de Batería (Segundo Plano)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Evita que el sistema operativo cierre KidsShield para ahorrar batería."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#6366F1"
                android:text="Permitir Ejecución Permanente"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Pairing Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#1E293B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vinculación con Panel de Padres"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScanQrPairing"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#6366F1"
            android:text="📷 Escanear Código QR de Vinculación"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="O ingresa manualmente los datos del servidor:"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1E293B"
            android:hint="URL del Servidor (ej: http://100.74.204.90:3000)"
            android:padding="12dp"
            android:text="http://100.74.204.90:3000"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1E293B"
            android:hint="Código del Dispositivo"
            android:padding="12dp"
            android:text="KID-PHONE-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStartProtection"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#10B981"
            android:text="✓ Iniciar Monitoreo y Protección"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Administration / Uninstallation Protection -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#1E293B" />

        <Button
            android:id="@+id/btnUninstallApp"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#7F1D1D"
            android:text="🗑️ Desinstalar Aplicación (Requiere PIN)"
            android:textColor="#FCA5A5"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
